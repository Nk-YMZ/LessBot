{
    "_comment": "NapCat WebSocket 连接配置",
    
    "napcat": {
        "host": "${NAPCAT_HOST:127.0.0.1}",
        "port": "${NAPCAT_PORT:3001}",
        "access_token": "${NAPCAT_ACCESS_TOKEN:}",
        "use_wss": false
    },
    
    "reconnect": {
        "enabled": true,
        "interval": 3,
        "max_retries": -1
    },
    
    "heartbeat": {
        "enabled": true,
        "interval": 30
    }
}
