{

    "_comment": "LessBot 模型配置模板 - 复制此文件为 models_config.json ，填入真实 API Key 并放入项目根目录",
    
    "api_keys": {
        "openai": "${OPENAI_API_KEY:你的OpenAI密钥}",
        "deepseek": "${DEEPSEEK_API_KEY:你的DeepSeek密钥}",
        "siliconflow": "${SILICONFLOW_API_KEY:你的SiliconFlow密钥}",
        "anthropic": "${ANTHROPIC_API_KEY:你的Anthropic密钥}",
        "custom": "${CUSTOM_API_KEY:你的自定义API密钥}"
    },
    
    "models": {
        "gpt-4o": {
            "api_url": "https://api.openai.com/v1/chat/completions",
            "api_key": "${api_keys.openai}",
            "model": "gpt-4o"
        },
        "deepseek-chat": {
            "api_url": "https://api.deepseek.com/v1/chat/completions",
            "api_key": "${api_keys.deepseek}",
            "model": "deepseek-chat"
        },
        "deepseek-reasoner": {
            "api_url": "https://api.deepseek.com/v1/chat/completions",
            "api_key": "${api_keys.deepseek}",
            "model": "deepseek-reasoner"
        },
        "claude-3-opus": {
            "api_url": "https://api.anthropic.com/v1/messages",
            "api_key": "${api_keys.anthropic}",
            "model": "claude-3-opus-20240229",
            "provider": "anthropic"
        },
        "claude-3-sonnet": {
            "api_url": "https://api.anthropic.com/v1/messages",
            "api_key": "${api_keys.anthropic}",
            "model": "claude-3-sonnet-20240229",
            "provider": "anthropic"
        },
        "qwen-turbo": {
            "api_url": "https://api.siliconflow.cn/v1/chat/completions",
            "api_key": "${api_keys.siliconflow}",
            "model": "Qwen/Qwen2.5-7B-Instruct"
        },
        "llama3-local": {
            "api_url": "http://localhost:11434/v1/chat/completions",
            "api_key": "not-required",
            "model": "llama3"
        },
        "slot_1": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_2": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_3": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_4": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_5": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_6": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_7": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        },
        "slot_8": {
            "api_url": "https://api.example.com/v1/chat/completions",
            "api_key": "${api_keys.custom}",
            "model": "model-name"
        }
    },
    
    "global_settings": {
        "default_timeout": 30,
        "max_retries": 2,
        "retry_delay": 1.0
    }
}
